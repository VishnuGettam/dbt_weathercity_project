    as (

with date_dimension as 
(
     select     
    to_timestamp(started_at) as started_at,
    date(to_timestamp(started_at)) as  date_started_at, 
    hour(to_timestamp(started_at)) as hour_started_at,
    dayofmonth(to_timestamp(started_at)) as month_started_at, 
    


case when to_timestamp( started_at  ) is not null  then
    case when month(to_timestamp( started_at )) in (12,1,2) then 'WINTER'     
         when month(to_timestamp( started_at )) in (3,4,5) then 'SPRING'     
         when month(to_timestamp( started_at )) in (6,7,8) then 'SUMMER'
    else 'AUTUMN'
    end 
else null
end


 as season_started_at,
    upper(cast(dayname(to_timestamp(started_at)) as string)) as dayname_started_at, 
    

case when to_timestamp(started_at) is not null then
    case when dayname(to_timestamp(started_at)) in ('Sun', 'Sat') then 'WEEKEND'
         else 'BUSINESSDAY'
    end
else null
end


 as daytype_started_at    

    from gainsight_dev.gainsight_dev_schema.tblcitybikes_stg limit 500
)
select 
*
from date_dimension
    )

